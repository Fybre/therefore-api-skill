{
  "schema_version": 1,
  "source": "https://raw.githubusercontent.com/Fybre/therefore-mcp/main/docs/export/tenant_operations.json",
  "source_commit": "f32d54f489c73f12025ad19bb03a5be017f49a6a",
  "verified_on": "2026-08-05",
  "operations": {
    "AddComment": {
      "method": "POST",
      "required": ["CommentText", "ObjNo", "ObjType"],
      "mutability": "write"
    },
    "CompleteTask": {
      "method": "POST",
      "required": ["Comment", "TaskDecision", "TaskNo"],
      "mutability": "write"
    },
    "CheckInDocument": {
      "method": "POST",
      "required": ["DocNo"],
      "optional": ["CheckInComment"],
      "mutability": "write",
      "note": "Requires an existing checkout with replacement content already opened/uploaded."
    },
    "CheckOutDocument": {
      "method": "POST",
      "required": ["DocNo"],
      "mutability": "write"
    },
    "CreateCase": {
      "method": "POST",
      "required": ["CaseDefNo"],
      "mutability": "write"
    },
    "CreateDocument": {
      "method": "POST",
      "required": ["CategoryNo", "IndexDataItems", "Streams"],
      "forbidden": ["TheDocument"],
      "mutability": "write",
      "note": "WithAutoAppendMode 0 uses the category default; mode 4 means no auto-append check."
    },
    "EditComment": {
      "method": "POST",
      "required": ["CommentText", "ID", "ObjNo", "ObjType"],
      "mutability": "write"
    },
    "ExecuteFullTextQuery": {
      "method": "POST",
      "required": ["FullTextQuery", "IncludeIndexData"],
      "response_root": "Results",
      "mutability": "read"
    },
    "ExecuteDependentFieldsQuery": {
      "method": "POST",
      "required": ["FieldNo", "IndexDataItems", "MaxRows", "SaveMode"],
      "context_members": ["CaseDefinitionNo", "CategoryNo"],
      "response_root": "QueryResult",
      "mutability": "read",
      "note": "Specify exactly one context member and omit the unused member; category context requires complete preprocessed/current IndexDataItems."
    },
    "ExecuteUsersQuery": {
      "method": "POST",
      "required": ["Flags"],
      "mutability": "read"
    },
    "ChangeUserPassword": {
      "method": "POST",
      "required": ["NewPassword", "OldPassword", "UserName"],
      "optional": ["DomainName"],
      "mutability": "write"
    },
    "CreateUser": {
      "method": "POST",
      "required": ["User"],
      "optional": ["Password"],
      "mutability": "write",
      "note": "User is nested and includes required Disabled and OneTimePwd boolean members."
    },
    "GetConnectedUser": {
      "method": "POST",
      "required": ["Create"],
      "response_root": "User",
      "mutability": "read"
    },
    "GetUserDetails": {
      "method": "POST",
      "required": ["UserOrGroupId"],
      "response_root": "UserDetails",
      "mutability": "read"
    },
    "GetUsersFromGroup": {
      "method": "POST",
      "required_one_of": ["GroupId", "GroupName"],
      "optional": ["DomainName"],
      "response_root": "Users",
      "mutability": "read"
    },
    "MoveUserLicense": {
      "method": "POST",
      "required": [],
      "mutability": "write",
      "note": "Moves the authenticated user's license from another node to the current node."
    },
    "ResetUserPwd": {
      "method": "POST",
      "required": ["UserInfo"],
      "mutability": "write"
    },
    "SignOut": {
      "method": "POST",
      "required": [],
      "mutability": "write",
      "note": "Releases the authenticated user's license on the current node."
    },
    "UpdateUserGroupAssignment": {
      "method": "POST",
      "required": ["Assignments", "User"],
      "mutability": "write"
    },
    "ExecuteTaskInfoQuery": {
      "method": "POST",
      "required": ["MaxRows", "QueryMode", "ViewMode"],
      "optional": ["TaskNo"],
      "response_root": "QueryResult",
      "mutability": "read"
    },
    "GetCategoriesTree": {
      "method": "POST",
      "required": [],
      "response_root": "TreeItems",
      "mutability": "read"
    },
    "FillDependentFields": {
      "method": "POST",
      "required": ["DoCalculateFields", "ExcludeRedundant", "IndexDataItems", "IsAccessMaskNeeded", "PrimaryFieldNo"],
      "context_members": ["CaseDefinitionNo", "CategoryNo", "DocNo"],
      "response_root": "UpdatedIndexDataItems",
      "mutability": "read",
      "note": "Specify exactly one context member. DocNo and CategoryNo are mutually exclusive; zero-valued placeholder members are not equivalent to omission."
    },
    "GetDocumentStream": {
      "method": "POST",
      "required": ["DocNo", "StreamNo"],
      "response_root": "FileData",
      "mutability": "read"
    },
    "GetObjects": {
      "method": "POST",
      "required": ["Flags", "Type"],
      "optional": ["PermType", "RoleAccessMask", "Permissions", "RequireAllPermissions"],
      "response_root": "ItemList",
      "mutability": "read",
      "note": "Do not send the uint64-max RoleAccessMask by default; it returned zero items on craigdemo 35.0.3.0 while the plain request returned 32."
    },
    "GetReferencedTableInfo": {
      "method": "POST",
      "required": ["DataTypeNo"],
      "mutability": "read"
    },
    "GetSystemCustomerId": {
      "method": "GET",
      "required": [],
      "mutability": "read"
    },
    "LoadComments": {
      "method": "POST",
      "required": ["MaxCount", "ObjNo", "ObjType"],
      "response_root": "Comments",
      "mutability": "read"
    },
    "SaveCaseIndexData": {
      "method": "POST",
      "required": ["CaseNo", "CheckInComments", "IndexData"],
      "mutability": "write"
    },
    "SaveCaseIndexDataQuick": {
      "method": "POST",
      "required": ["CaseNo", "CheckInComments", "IndexData"],
      "mutability": "write"
    },
    "LinkCaseToDocument": {
      "method": "POST",
      "required": ["CaseNo", "DocNo"],
      "mutability": "write",
      "note": "The accepted schema is known, but live read-back has not confirmed the link effect."
    },
    "LinkCases": {
      "method": "POST",
      "required": ["CaseNoA", "CaseNoB"],
      "mutability": "write"
    },
    "UnlinkCases": {
      "method": "POST",
      "required": ["CaseNoA", "CaseNoB"],
      "mutability": "write"
    },
    "RestoreDeletedCase": {
      "method": "POST",
      "required": ["CaseNo", "RestoreRelatedDocuments"],
      "mutability": "write"
    },
    "UndoCheckOutDocument": {
      "method": "POST",
      "required": ["DocNo"],
      "mutability": "write"
    },
    "PreprocessIndexData": {
      "method": "POST",
      "required": ["CategoryNo", "IndexData"],
      "mutability": "read"
    },
    "GetSettings": {
      "method": "POST",
      "required": ["SettingKeys"],
      "response_root": "Settings",
      "mutability": "read"
    },
    "GetGlobalSettings": {
      "method": "POST",
      "required": ["Settings"],
      "response_root": "SettingValues",
      "mutability": "read"
    },
    "GetSettingString": {
      "method": "POST",
      "required": ["SettingKey"],
      "response_root": "SettingValue",
      "mutability": "read"
    },
    "GetSettingInt": {
      "method": "POST",
      "required": ["SettingKey"],
      "response_root": "SettingValue",
      "mutability": "read"
    },
    "ExecuteWorkflowQueryForAll": {
      "method": "POST",
      "required": ["WorkflowFlags"],
      "optional": ["MaxRows"],
      "response_root": "WorkflowQueryResultList",
      "mutability": "read",
      "note": "WorkflowFlags 0 = inbox (DefaultInstances, includes group tasks); 1 = RunningInstances also includes process-owner-only instances."
    },
    "GetWorkflowInstance": {
      "method": "POST",
      "required": ["InstanceNo", "TokenNo"],
      "response_root": "WorkflowInstance",
      "mutability": "read"
    },
    "ClaimWorkflowInstance": {
      "method": "POST",
      "required": ["InstanceNo", "TokenNo"],
      "mutability": "write"
    },
    "DisclaimWorkflowInstance": {
      "method": "POST",
      "required": ["InstanceNo", "TokenNo"],
      "mutability": "write"
    },
    "DelegateWorkflowInstance": {
      "method": "POST",
      "required": ["DomainName", "InstanceNo", "TokenNo", "UserName"],
      "mutability": "write",
      "note": "DomainName is required by the server (\"\" for internal users); the instance must be claimed first."
    },
    "FinishCurrentWorkflowTask": {
      "method": "POST",
      "required": ["InstanceNo", "NextTaskNo", "TokenNo"],
      "optional": ["NextUsers", "TextInformation"],
      "mutability": "write"
    },
    "LinkDocAndWFInstance": {
      "method": "POST",
      "required": ["DocNo", "TokenNo", "WorkflowInstanceNo"],
      "optional": ["AutoClaimWorkflowInstance"],
      "mutability": "write"
    },
    "GetObjectsList": {
      "method": "POST",
      "required": ["LoadItemsList"],
      "response_root": "AllItemsList",
      "mutability": "read",
      "note": "Types 12 and 20 are unsupported and fail the whole call."
    },
    "RemoveNotificationSubscriptions": {
      "method": "POST",
      "required": ["RemoveGuids"],
      "mutability": "write"
    },
    "CreateSharedLink": {
      "method": "POST",
      "required": ["DocNo", "PermissionType", "ShareType"],
      "response_root": "SharedLink",
      "mutability": "write"
    },
    "RevokeSharedLink": {
      "method": "POST",
      "required": ["LinkId"],
      "mutability": "write"
    },
    "GetThumbnail": {
      "method": "POST",
      "required": ["DocNo"],
      "optional": ["RequestedThumbnailFormat", "SizeInPixels"],
      "mutability": "read",
      "note": "SizeInPixels 0 returns Exists: false."
    },
    "SaveDocumentIndexDataQuick": {
      "method": "POST",
      "required": ["DocNo", "IndexData"],
      "optional": ["CheckInComments"],
      "mutability": "write",
      "note": "No LastChangeTime or concurrency check; table fields unsupported."
    },
    "GenerateWebRefererenceNo": {
      "method": "POST",
      "required": ["OriginValue"],
      "mutability": "read"
    },
    "GetConvertedDocStreamsRaw": {
      "method": "POST",
      "required": ["ConversionOptions", "DocNo", "StreamNos"],
      "optional": ["VersionNo"],
      "mutability": "read",
      "note": "Returns the binary file, not JSON."
    },
    "ExecuteAsyncSingleQuery": {
      "method": "POST",
      "required": ["Query"],
      "optional": ["FullText"],
      "mutability": "read",
      "note": "Full-text filter goes in top-level FullText; Query.FullText is ignored."
    },
    "GetNextFullTextQueryRows": {
      "method": "POST",
      "required": ["QueryID"],
      "mutability": "read"
    },
    "GetJWTToken": {
      "method": "POST",
      "required": [],
      "response_root": "JWTToken",
      "mutability": "read",
      "note": "24 h from Basic auth; one 12 h renewal with Bearer, then the same token is returned."
    },
    "GetClientDiscoveryInfo": {
      "method": "POST",
      "required": [],
      "mutability": "read"
    },
    "GetOutOfOfficeInfoForUser": {
      "method": "POST",
      "required": [],
      "optional": ["GetAsDelegateInfoList", "User"],
      "response_root": "UserOutOfOfficeInfo",
      "mutability": "read"
    }
  }
}
